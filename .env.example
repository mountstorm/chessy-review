# --- Engine -----------------------------------------------------------------
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish   # auto-detected from PATH when unset
# ENGINE_POOL_SIZE=0                           # 0 = auto (half your cores, 1-4)
# ENGINE_HASH_MB=64
# DEFAULT_DEPTH=14
# MAX_DEPTH=24

# --- Storage / cache --------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///./chessy.db
# REDIS_URL=redis://localhost:6379/0           # optional: `pip install redis`; in-memory LRU is used otherwise

# --- AI coach (all optional: with nothing configured you get the offline engine-grounded coach) ---
# auto picks, in order: Anthropic key -> OpenAI key -> a local Ollama server -> offline coach
LLM_PROVIDER=auto            # auto | anthropic | openai | local | offline
# Free + private local model (run ./setup_local_llm.sh):
# LOCAL_LLM_URL=http://localhost:11434/v1    # Ollama, LM Studio, llama.cpp server...
# LOCAL_LLM_MODEL=qwen2.5:3b
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low       # low | medium | high ; low keeps replies snappy
# ANTHROPIC_REFUSAL_FALLBACK=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# --- Hosted rate limits: shared counts across serverless instances (optional; in-memory per instance when unset) ---
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# --- Server -----------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000   # default "*" (fine for local use)
